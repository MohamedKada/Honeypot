# ============================================================================
# .env.example — Modèle de configuration du honeypot SSH
# ============================================================================
#
# INSTRUCTIONS :
#   1. Copiez ce fichier :  cp .env.example .env
#   2. Remplissez les valeurs dans .env
#   3. Ne committez JAMAIS .env (il est dans .gitignore)
#
# ============================================================================

# Clé API Anthropic pour le fallback IA (Claude Haiku 4.5)
# Obtenez votre clé sur : https://console.anthropic.com
# Laissez vide pour désactiver le fallback IA.
ANTHROPIC_API_KEY=

# URL webhook Discord ou Slack pour les alertes hauts scores MITRE
# Discord  : https://discord.com/api/webhooks/XXXXXXXX/YYYYYYY
# Slack    : https://hooks.slack.com/services/XXXXXXXX/YYYYYYY
# Laissez vide pour désactiver les alertes webhook.
HONEYPOT_WEBHOOK_URL=

# Score MITRE minimum (0-10) pour déclencher une alerte webhook
# 0-2 : bruit réseau   3-4 : reconnaissance   5-6 : recherche active
# 7-8 : exploitation   9-10 : attaque sophistiquée
# Valeur recommandée : 5
SEUIL_ALERTE=5
